BACKEND_URL=http://127.0.0.1:5000
BACKEND_CALLBACK_SECRET=replace-with-the-same-secret-as-backend
AI_SERVICE_SECRET=replace-with-the-same-secret-as-backend
DJANGO_SECRET_KEY=replace-with-a-random-local-secret
# Leave unset for local dev (falls back to a local db.sqlite3 file).
# In production, set this to your hosted Postgres connection string, e.g.
# postgres://user:password@host:5432/dbname
DATABASE_URL=
# Comma-separated hostnames this service is allowed to answer as. Add your
# Render hostname (e.g. usar-sarthi-ai.onrender.com) in production.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
